---
import MainLayout from "../layouts/mainlayout.astro";
import HomeNotice from "../components/HomeNotice.astro";

// Flip to true to bring the Latest card back.
const showLatest = false;
---

<MainLayout isHome={true}>
  <div class="home-content">
    <h1>Alex<br><span class="nudge">Hordal</span></h1>
    <p class="hero-subtitle">Cartographer &<br class="subtitle-break"> GIS Specialist</p>
  </div>

  {showLatest && <HomeNotice projectId="hawaii-seafloor-to-summit" />}
</MainLayout>