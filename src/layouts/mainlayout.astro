---
import "../styles/global.css";
import "@fortawesome/fontawesome-free/css/all.min.css";

const {
  title = "Alex Hordal | Cartographer & GIS Specialist",

  description = "Portfolio of Alex Hordal, a cartographer and GIS specialist focused on terrain visualization, cartographic design, spatial analysis, and geospatial storytelling.",

  socialImage = "/social-preview.webp",

  isHome = false,
} = Astro.props;

const { pathname } = Astro.url;

const isActive = (path: string) => pathname === path || pathname === path + "/";

// Mobile menu breadcrumb, built like the page breadcrumbs; the homepage has no segments.
const pathSegments = pathname.split("/").filter(Boolean).map(decodeURIComponent);
const crumbs = pathSegments.length
  ? pathSegments.map((segment, i) => ({
      label: segment,
      href: "/" + pathSegments.slice(0, i + 1).join("/"),
    }))
  : [{ label: "home", href: "/" }];

// Footer Socials panel, styled like resource links.
const footerRows = [
  { label: "LinkedIn", description: "alex-hordal", icon: "fa-brands fa-linkedin", href: "https://www.linkedin.com/in/alex-hordal/" },
  { label: "GitHub", description: "Ahordal", icon: "fa-brands fa-github", href: "https://github.com/Ahordal" },
  { label: "ULLR Maps", description: "ullrmaps.com", icon: "fa-solid fa-mountain", href: "https://www.ullrmaps.com" },
];

// Icons and descriptions only show in the mobile menu, where links render as resource-style rows.
const navItems = [
  { href: "/", label: "Home", icon: "fa-solid fa-house", description: "Back to the start" },
  { href: "/about", label: "About", icon: "fa-solid fa-user", description: "Background, education and skills" },
  { href: "/portfolio", label: "Portfolio", icon: "fa-solid fa-folder-open", description: "Maps, dashboards and analysis" },
  { href: "/blog", label: "Blog", icon: "fa-solid fa-code", description: "Notes on building maps and apps" },
  { href: "/contact", label: "Contact", icon: "fa-solid fa-envelope", description: "Get in touch" },
];
---

<!doctype html>
<html lang="en">
<head>

<!-- Google Analytics -->

<script async src="https://www.googletagmanager.com/gtag/js?id=G-TLE82M0RH4"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-TLE82M0RH4');
</script>

  <meta charset="utf-8" />
  <link rel="canonical" href={Astro.url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:image" content={socialImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="generator" content={Astro.generator} />

  

  <title>{title}</title>
</head>

  <body class="site-root">
    <header class="main-nav">
      <nav class="nav-container">
        <a href="/" class="nav-brand">Alex Hordal</a>

        <button
          type="button"
          class="menu-toggle"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="nav-links"
          data-label="Menu"
          data-icon="fa-burger"
        >
          <i class="fa-solid fa-burger menu-toggle-icon" aria-hidden="true"></i>
        </button>

        <div class="nav-links" id="nav-links">
          <h2 class="nav-menu-title">
            <i class="fa-solid fa-burger section-icon" aria-hidden="true"></i> Menu
          </h2>

          <div class="nav-entries">
            <p class="project-path nav-location">
              <span>/ </span>
              {crumbs.map((crumb, i) =>
                i === crumbs.length - 1 ? (
                  <span class="project-slug" aria-current="page">{crumb.label}</span>
                ) : (
                  <>
                    <a href={crumb.href}>{crumb.label}</a>
                    <span> / </span>
                  </>
                )
              )}
            </p>

            {navItems.map((item) => (
              <a href={item.href} class={isActive(item.href) ? "active" : ""}>
                <span class="resource-icon" aria-hidden="true">
                  <i class={item.icon}></i>
                </span>

                <span class="resource-content">
                  <span class="nav-label">{item.label}</span>
                  <span class="nav-desc">{item.description}</span>
                </span>

                <span class="resource-arrow" aria-hidden="true">
                  <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    </header>

    <main class={`page-slot ${isHome ? "home-bg" : "content-bg"}`}>
      <slot />
    </main>

    <footer class="main-footer">
      <!-- One footer at every width: location and colophon in the bar, socials in an upward panel. -->
      <div class="footer-bar">
        <p class="footer-group footer-text">
          <span>
            LOC: DARTMOUTH, NS
            <i class="fa-brands fa-canadian-maple-leaf" aria-hidden="true"></i>
            // 44.66° N, 63.56° W
          </span>

          <span class="footer-sep" aria-hidden="true">|</span>

          <a href="/colophon" class={isActive("/colophon") ? "active" : ""}>Colophon</a>

          <span class="footer-sep" aria-hidden="true">|</span>

          <button
            type="button"
            class="menu-toggle"
            aria-label="Open Socials"
            aria-expanded="false"
            aria-controls="footer-rows"
            data-label="Socials"
            data-icon="fa-share-nodes"
          >
            <i class="fa-solid fa-share-nodes menu-toggle-icon" aria-hidden="true"></i>
          </button>
        </p>
      </div>

      <div class="footer-rows" id="footer-rows">
        <h2 class="nav-menu-title">
          <i class="fa-solid fa-share-nodes section-icon" aria-hidden="true"></i> Socials
        </h2>

        <div class="footer-entries">
          {footerRows.map((row) => (
            <a
              href={row.href}
              class="resource-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="resource-icon" aria-hidden="true">
                <i class={row.icon}></i>
              </span>

              <span class="resource-content">
                <span class="nav-label">{row.label}</span>
                <span class="nav-desc">{row.description}</span>
              </span>

              <span class="resource-arrow" aria-hidden="true">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </span>
            </a>
          ))}
        </div>

        <p class="footer-panel-copy">© Alex Hordal 2026</p>
      </div>
    </footer>
  </body>

  <script>
    // Header menu and footer panel share one toggle; each button names its panel.
    document.querySelectorAll<HTMLButtonElement>(".menu-toggle").forEach((button) => {
      const panel = document.getElementById(button.getAttribute("aria-controls") ?? "");
      const icon = button.querySelector(".menu-toggle-icon");
      const { label = "", icon: openIcon = "" } = button.dataset;

      button.addEventListener("click", () => {
        const isOpen = panel?.classList.toggle("is-active") ?? false;

        button.setAttribute("aria-expanded", String(isOpen));
        button.setAttribute("aria-label", `${isOpen ? "Close" : "Open"} ${label}`);

        // Swaps to the same close mark the Latest card uses.
        icon?.classList.toggle(openIcon, !isOpen);
        icon?.classList.toggle("fa-xmark", isOpen);

        if (isOpen && panel?.id === "footer-rows") alignFooterPanel(button, panel);
      });
    });

    // Desktop: the Socials panel opens above its icon, left edges aligned, kept on screen.
    // Phones use the full-width CSS layout, so any inline position is cleared there.
    function alignFooterPanel(button: HTMLElement, panel: HTMLElement) {
      if (!window.matchMedia("(min-width: 769px)").matches) {
        panel.style.left = "";
        return;
      }

      const footerLeft = panel.offsetParent?.getBoundingClientRect().left ?? 0;
      const maxLeft = document.documentElement.clientWidth - panel.offsetWidth;
      const left = Math.min(button.getBoundingClientRect().left, maxLeft) - footerLeft;

      panel.style.left = `${Math.max(left, 0)}px`;
    }
  </script>
</html>
