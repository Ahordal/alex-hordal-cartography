---
import "../styles/global.css";
import "@fortawesome/fontawesome-free/css/all.min.css";

const {
  title = "Alex Hordal | Cartographer & GIS Specialist",

  description = "Portfolio of Alex Hordal, a cartographer and GIS specialist focused on terrain visualization, cartographic design, spatial analysis, and geospatial storytelling.",

  socialImage = "/social-preview.webp",

  isHome = false,
} = Astro.props;

const { pathname } = Astro.url;

const isActive = (path: string) => pathname === path || pathname === path + "/";

// Mobile menu breadcrumb, built like the page breadcrumbs; the homepage has no segments.
const pathSegments = pathname.split("/").filter(Boolean).map(decodeURIComponent);
const crumbs = pathSegments.length
  ? pathSegments.map((segment, i) => ({
      label: segment,
      href: "/" + pathSegments.slice(0, i + 1).join("/"),
    }))
  : [{ label: "home", href: "/" }];

// Mobile footer rows, styled like resource links; desktop keeps the one-line footer.
const footerRows = [
  { label: "ULLR Maps", description: "ullrmaps.com", icon: "fa-solid fa-mountain", href: "https://www.ullrmaps.com", external: true },
  { label: "Colophon", description: "How this site is built", icon: "fa-solid fa-book-open", href: "/colophon", external: false },
  { label: "LinkedIn", description: "alex-hordal", icon: "fa-brands fa-linkedin", href: "https://www.linkedin.com/in/alex-hordal/", external: true },
  { label: "GitHub", description: "Ahordal", icon: "fa-brands fa-github", href: "https://github.com/Ahordal", external: true },
];

// Icons and descriptions only show in the mobile menu, where links render as resource-style rows.
const navItems = [
  { href: "/", label: "Home", icon: "fa-solid fa-house", description: "Back to the start" },
  { href: "/about", label: "About", icon: "fa-solid fa-user", description: "Background, education and skills" },
  { href: "/portfolio", label: "Portfolio", icon: "fa-solid fa-folder-open", description: "Maps, dashboards and analysis" },
  { href: "/contact", label: "Contact", icon: "fa-solid fa-envelope", description: "Get in touch" },
];
---

<!doctype html>
<html lang="en">
<head>

<!-- Google Analytics -->

<script async src="https://www.googletagmanager.com/gtag/js?id=G-TLE82M0RH4"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-TLE82M0RH4');
</script>

  <meta charset="utf-8" />
  <link rel="canonical" href={Astro.url} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url} />
  <meta property="og:image" content={socialImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="generator" content={Astro.generator} />

  

  <title>{title}</title>
</head>

  <body class="site-root">
    <header class="main-nav">
      <nav class="nav-container">
        <a href="/" class="nav-brand">Alex Hordal</a>

        <button
          type="button"
          class="menu-toggle"
          aria-label="Open Menu"
          aria-expanded="false"
          aria-controls="nav-links"
          data-label="Menu"
          data-icon="fa-burger"
        >
          <i class="fa-solid fa-burger menu-toggle-icon" aria-hidden="true"></i>
        </button>

        <div class="nav-links" id="nav-links">
          <h2 class="nav-menu-title">
            <i class="fa-solid fa-burger section-icon" aria-hidden="true"></i> Menu
          </h2>

          <div class="nav-entries">
            <p class="project-path nav-location">
              <span>/ </span>
              {crumbs.map((crumb, i) =>
                i === crumbs.length - 1 ? (
                  <span class="project-slug" aria-current="page">{crumb.label}</span>
                ) : (
                  <>
                    <a href={crumb.href}>{crumb.label}</a>
                    <span> / </span>
                  </>
                )
              )}
            </p>

            {navItems.map((item) => (
              <a href={item.href} class={isActive(item.href) ? "active" : ""}>
                <span class="resource-icon" aria-hidden="true">
                  <i class={item.icon}></i>
                </span>

                <span class="resource-content">
                  <span class="nav-label">{item.label}</span>
                  <span class="nav-desc">{item.description}</span>
                </span>

                <span class="resource-arrow" aria-hidden="true">
                  <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    </header>

    <main class={`page-slot ${isHome ? "home-bg" : "content-bg"}`}>
      <slot />
    </main>

    <footer class="main-footer">
      <div class="footer-container">
        <div class="footer-group">
          LOC: DARTMOUTH, NS
          <i class="fa-brands fa-canadian-maple-leaf"></i>
          // 44.66° N, 63.56° W
        </div>

        <nav class="footer-group">
          <a
            href="https://www.ullrmaps.com"
            target="_blank"
            rel="noopener noreferrer">
            ULLR Maps
          </a>

          <span class="footer-sep" aria-hidden="true">|</span>

          <a href="/colophon" class={isActive("/colophon") ? "active" : ""}>
            Colophon
          </a>

          <span class="footer-sep" aria-hidden="true">|</span>

          <div class="social-links">
  <a
    href="https://www.linkedin.com/in/alex-hordal/"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Visit Alex Hordal's LinkedIn profile">
    <i class="fa-brands fa-linkedin" aria-hidden="true"></i>
  </a>

  <a
    href="https://github.com/Ahordal"
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Visit Alex Hordal's GitHub profile">
    <i class="fa-brands fa-github" aria-hidden="true"></i>
  </a>
</div>

          <span class="footer-sep" aria-hidden="true">|</span>
        </nav>

        <span class="footer-copy">© ALEX HORDAL 2026</span>
      </div>

      <!-- Phone footer: mirrors the header bar, with a panel that opens upward. -->
      <div class="footer-bar">
        <span class="nav-brand">© Alex Hordal 2026</span>

        <button
          type="button"
          class="menu-toggle"
          aria-label="Open Site Information"
          aria-expanded="false"
          aria-controls="footer-rows"
          data-label="Site Information"
          data-icon="fa-wrench"
        >
          <i class="fa-solid fa-wrench menu-toggle-icon" aria-hidden="true"></i>
        </button>
      </div>

      <div class="footer-rows" id="footer-rows">
        <button
          type="button"
          class="panel-dismiss"
          aria-label="Close Site Information"
          data-closes="footer-rows"
        >
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>

        <h2 class="nav-menu-title">
          <i class="fa-solid fa-wrench section-icon" aria-hidden="true"></i> Site Information
        </h2>

        <div class="footer-entries">
          <div class="resource-note">
            <span class="resource-icon" aria-hidden="true">
              <i class="fa-solid fa-location-dot"></i>
            </span>

            <span class="resource-content">
              <span class="nav-label">Dartmouth, NS</span>
              <span class="nav-desc">44.66° N, 63.56° W</span>
            </span>
          </div>

          {footerRows.map((row) => (
            <a
              href={row.href}
              class="resource-link"
              target={row.external ? "_blank" : undefined}
              rel={row.external ? "noopener noreferrer" : undefined}
            >
              <span class="resource-icon" aria-hidden="true">
                <i class={row.icon}></i>
              </span>

              <span class="resource-content">
                <span class="nav-label">{row.label}</span>
                <span class="nav-desc">{row.description}</span>
              </span>

              <span class="resource-arrow" aria-hidden="true">
                <i class="fa-solid fa-arrow-up-right-from-square"></i>
              </span>
            </a>
          ))}

        </div>
      </div>
    </footer>
  </body>

  <script>
    // Header menu and footer panel share one toggle; each button names its panel.
    document.querySelectorAll<HTMLButtonElement>(".menu-toggle").forEach((button) => {
      const panel = document.getElementById(button.getAttribute("aria-controls") ?? "");
      const icon = button.querySelector(".menu-toggle-icon");
      const { label = "", icon: openIcon = "" } = button.dataset;

      button.addEventListener("click", () => {
        const isOpen = panel?.classList.toggle("is-active") ?? false;

        button.setAttribute("aria-expanded", String(isOpen));
        button.setAttribute("aria-label", `${isOpen ? "Close" : "Open"} ${label}`);

        // Swaps to the same close mark the Latest card uses.
        icon?.classList.toggle(openIcon, !isOpen);
        icon?.classList.toggle("fa-xmark", isOpen);
      });
    });

    // In-panel close buttons route through the panel's toggle so its state stays in sync.
    document.querySelectorAll<HTMLButtonElement>("[data-closes]").forEach((button) => {
      button.addEventListener("click", () => {
        const toggle = document.querySelector<HTMLButtonElement>(
          `.menu-toggle[aria-controls="${button.dataset.closes}"]`
        );

        toggle?.click();
        toggle?.focus();
      });
    });
  </script>
</html>
