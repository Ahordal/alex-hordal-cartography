---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

import PageSubsection from "./PageSubsection.astro";

interface Props {
  plainTitle: string;
  description: string;
  image: ImageMetadata;
  href: string;
  tags?: string[];
  objectPosition?: string;
  aiAssisted?: boolean;
}

const {
  plainTitle,
  description,
  image,
  href,
  tags = [],
  objectPosition = "center",
  aiAssisted = false,
} = Astro.props;
---

<a
  href={href}
  class="portfolio-plate"
  style={`--object-position: ${objectPosition};`}>
  <div class="plate-image">
    <Image src={image} alt={plainTitle} loading="lazy" />

    {aiAssisted && (
      <div class="ai-badge" role="img" aria-label="Built with AI assistance">
        <i class="fa-solid fa-brain" aria-hidden="true"></i>
      </div>
    )}
  </div>

  <div class="plate-content">
    <PageSubsection title={plainTitle}>
      <p class="plate-description">
        {description}
      </p>

      
    </PageSubsection>
  </div>
</a>
