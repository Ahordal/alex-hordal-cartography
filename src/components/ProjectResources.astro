---
import ResourceRow from "./ResourceRow.astro";

interface Resource {
  label: string;
  url: string;
  icon: string;
  description?: string;
}

interface Recognition {
  label: string;
  icon: string;
  description?: string;
  url?: string;
}

interface Props {
  resources?: Resource[];
  recognition?: Recognition[];
  aiAssisted?: boolean;
}

const { resources, recognition, aiAssisted } = Astro.props;
---

<div class="project-resources">
  {recognition?.map((item) => <ResourceRow {...item} />)}

  {resources?.map((resource) => <ResourceRow {...resource} />)}

  {
    aiAssisted && (
      <ResourceRow
        label="AI-Assisted Development"
        icon="fa-solid fa-brain"
        description="This project was developed through a combination of traditional development and iterative AI-assisted workflows."
      />
    )
  }
</div>
