---
import { getEntry } from "astro:content";
import { getFeaturedImage } from "../utils/getFeaturedImage";
import PortfolioPlate from "./PortfolioPlate.astro";

// Reference card for a project, opened by a matching <ProjectRef>. Place it
// after the paragraph holding the link: a card has block content (headings,
// paragraphs), which can't sit inside a <p>.
interface Props {
  project: string;
}

const { project } = Astro.props;

const entry = await getEntry("projects", project);
if (!entry) throw new Error(`ProjectHoverCard: no project "${project}"`);

const { plainTitle, description, objectPosition = "center", aiAssisted } = entry.data;
const id = `project-card-${project}`;
---

<!-- The same plate as on the portfolio page, in a floating frame. -->
<article class="project-card" id={id} role="tooltip" aria-label={plainTitle}>
  <PortfolioPlate
    plainTitle={plainTitle}
    description={description}
    image={getFeaturedImage(project)}
    href={`/portfolio/${project}`}
    objectPosition={objectPosition}
    aiAssisted={aiAssisted}
  />
</article>

<script>
  // Fixed-position cards, placed under their link on hover or focus. Touch
  // screens skip this and just follow the link.
  const canHover = window.matchMedia("(hover: hover)").matches;
  const links = document.querySelectorAll<HTMLAnchorElement>("[data-project-card]");

  // Thumbnail as tall as the text beside it, at the image's own proportions.
  // Widening it narrows the text, which makes it taller, so repeat until the
  // size settles. Capped at 40% of the card so long text can't squeeze itself
  // into a sliver; past the cap the image crops.
  const sizeThumb = (card: HTMLElement) => {
    const thumb = card.querySelector<HTMLElement>(".plate-image");
    const img = thumb?.querySelector("img");
    const text = card.querySelector<HTMLElement>(".plate-content");
    if (!thumb || !img || !text) return;
    const ratio = Number(img.getAttribute("width")) / Number(img.getAttribute("height")) || 1;
    const maxWidth = card.clientWidth * 0.4;
    for (let i = 0; i < 5; i++) {
      const width = Math.min(text.offsetHeight * ratio, maxWidth);
      if (Math.abs(thumb.offsetWidth - width) < 1) break;
      thumb.style.width = `${width}px`;
    }
  };

  links.forEach((link) => {
    const card = document.getElementById(link.dataset.projectCard!);
    if (!card || !canHover) return;

    let hideTimer: number | undefined;

    const show = () => {
      clearTimeout(hideTimer);
      const rect = link.getBoundingClientRect();
      card.classList.add("is-open");
      sizeThumb(card);
      const width = card.offsetWidth;
      const left = Math.min(rect.left, window.innerWidth - width - 16);
      card.style.left = `${Math.max(16, left)}px`;
      card.style.top = `${rect.bottom + 8}px`;
    };
    const hide = () => {
      hideTimer = window.setTimeout(() => card.classList.remove("is-open"), 120);
    };

    link.addEventListener("mouseenter", show);
    link.addEventListener("mouseleave", hide);
    link.addEventListener("focus", show);
    link.addEventListener("blur", hide);
    card.addEventListener("mouseenter", () => clearTimeout(hideTimer));
    card.addEventListener("mouseleave", hide);
    window.addEventListener("scroll", () => card.classList.remove("is-open"), {
      passive: true,
      capture: true,
    });
  });
</script>
